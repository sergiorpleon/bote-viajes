# Copy to .env to enable the shared bote. Without these, the app stores
# everything in localStorage and each browser has its own separate data.
#
# The anon key is meant to be public (it ships in the JS bundle). Security
# comes from the row-level security policy you set on the table, not from
# hiding this value. See README.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
